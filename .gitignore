/.quarto/
/_freeze/
/_site/
/docs/

# Hugo build artefacts (migration/hugo-coder)
/public/
/resources/
.hugo_build.lock

# Phase 3 placeholder binaries — regenerated in CI by
# _scripts/make_placeholder_{worksheets,presentations,thumbnails}.py.
# To replace a placeholder with a real material:
#   1. Drop the real .pptx / .pdf at the canonical path under static/.
#   2. `git add -f <path>` to commit it past this ignore.
# The placeholder generators run with --skip-existing by default, so a
# real material committed at the canonical path survives every CI re-run.
# The thumbnail generator always re-renders from whatever binary exists
# at the path, so a swapped real file gets a fresh thumbnail next deploy.
/static/downloads/
/static/materials/presentations/
/static/materials/worksheets/

# Materials Discovery Network — npm deps for Cytoscape bundling.
/node_modules/
# Hugo auto-emits this for IDE go-to-definition; not source.
/assets/jsconfig.json

# Bildungsplan live-fetch response cache (24h TTL, regenerated as needed).
/_resources/.bildungsplan_cache/

*.html
!**/index.html
# Hugo layouts and partials are HTML — never ignore them.
!layouts/**/*.html
.DS_Store
__pycache__/
*.pyc
.venv/
.env
node_modules/
/downloads/
/docs/downloads/
.Rproj.user
.Rhistory
.RData

**/*.quarto_ipynb
*.tmp
*.log
*~
*.bak
*.orig
dist/

# TTS audio hash cache
static/materials/audio/**/.*.hash
