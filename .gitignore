/.quarto/
/_freeze/
/_site/
/docs/

# Hugo build artefacts (migration/hugo-coder)
/public/
/resources/
.hugo_build.lock

# Materials are COMMITTED, as in every other course. They were ignored here
# and regenerated in CI as placeholders, which is the arrangement ADR-0009
# forbids: CI verifies materials, it does not generate them. A TeX point
# release must not silently reflow 360 documents between two deploys, and a
# workflow that writes binaries into the repo is one dispatch away from
# replacing real branded worksheets with placeholders.
#
# Nothing generates these in CI any more, so ignoring them would leave every
# download link on the site pointing at a file that does not exist.
/static/downloads/

# Materials Discovery Network — npm deps for Cytoscape bundling.
/node_modules/
# Hugo auto-emits this for IDE go-to-definition; not source.
/assets/jsconfig.json

# Bildungsplan live-fetch response cache (24h TTL, regenerated as needed).
/_resources/.bildungsplan_cache/

*.html
!**/index.html
# Hugo layouts and partials are HTML — never ignore them.
!layouts/**/*.html
.DS_Store
__pycache__/
*.pyc
.venv/
.env
node_modules/
/downloads/
/docs/downloads/
.Rproj.user
.Rhistory
.RData

**/*.quarto_ipynb
*.tmp
*.log
*~
*.bak
*.orig
dist/

# TTS audio hash cache
static/materials/audio/**/.*.hash

# LaTeX materials build artifacts
_materials/build/
_materials/*.aux
_materials/*.log
_materials/*.nav
_materials/*.snm
_materials/*.toc
_materials/*.out
